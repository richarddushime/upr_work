library(ggplot2)
library(gridExtra)
p1 <- ggplot(chick_two %>% filter(feed == "meatmeal"), aes(sample = weight)) +
stat_qq() + stat_qq_line(color = "red") +
theme_classic() +
labs(title = "QQ-Plot – Meatmeal (p = 0.961)")
p2 <- ggplot(chick_two %>% filter(feed == "soybean"), aes(sample = weight)) +
stat_qq() + stat_qq_line(color = "red") +
theme_classic() +
labs(title = "QQ-Plot – Soybean (p = 0.710)")
gridExtra::grid.arrange(p1, p2, ncol = 2)
