data(chickwts)
chick_case_lin <- chickwts %>%
filter(feed %in% c("casein", "linseed"))
#| label: summary
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
chick_case_lin %>%
group_by(feed) %>%
summarise(
n = n(),
mean_weight = mean(weight),
sd_weight = sd(weight)
)
#| label: vis-density
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
ggplot(chick_case_lin, aes(x = weight, fill = feed)) +
geom_density(alpha = 0.6) +
theme_classic() +
scale_fill_viridis_d(option = "viridis") +
labs(title = "Density Plot of Chicken Weights: Casein vs Linseed")
#| label: check-normality
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
shapiro.test(chick_case_lin$weight[chick_case_lin$feed == "casein"])
shapiro.test(chick_case_lin$weight[chick_case_lin$feed == "linseed"])
#| label: check-variance-task2
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
var.test(weight ~ feed, data = chick_case_lin)
#| label: t-test-task2
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
t.test(weight ~ feed, data = chick_case_lin)
#| label: wilcoxon
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
wilcox.test(weight ~ feed, data = chick_case_lin, conf.int = TRUE)
#| label: plot-iris
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
data(iris)
ggplot(iris, aes(x = Petal.Length, y = Petal.Width, color = Species)) +
geom_point() +
theme_classic() +
labs(title = "Petal Width vs Petal Length by Iris Species",
caption = "Anderson, E. (1935). The irises of the Gaspé Peninsula. Bulletin of the American Iris Society, 59, 2–5.")
#| label: fit-lm-iris
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
iris_lm <- lm(Petal.Width ~ Petal.Length * Species, data = iris)
summary(iris_lm)
# Diagnostic plots to check appropriateness
plot(iris_lm)
#| label: coefficients-iris
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
coef(iris_lm)
#| label: emmeans-iris
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
library(emmeans)
iris_em <- emmeans(iris_lm, ~ Species | Petal.Length, at = list(Petal.Length = mean(iris$Petal.Length)))
iris_pairs <- pairs(iris_em)
confint(iris_pairs)
# Table (as tibble)
as_tibble(confint(iris_pairs))
#| label: vis-differences-iris
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
library(tidyverse)
iris_pairs_df <- as_tibble(confint(iris_pairs))
ggplot(iris_pairs_df, aes(x = contrast, y = estimate, ymin = lower.CL, ymax = upper.CL)) +
geom_pointrange() +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
coord_flip() +
theme_minimal() +
labs(title = "Pairwise Differences in Petal Width Between Species",
y = "Difference in Petal Width (mm)", x = "Contrast")
#| label: vis-reg-lines-iris
#| echo: true
#| code-fold: true
#| code-summary: "click for code"
ggplot(iris, aes(x = Petal.Length, y = Petal.Width, color = Species)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
theme_classic() +
labs(title = "Petal Width vs Petal Length with Regression Lines by Species")
