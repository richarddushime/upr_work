#| label: import_data
# packages
library(dplyr)
library(ggplot2)
creativity.d <- read.csv("hw1_creativity.csv")
head(creativity.d)
#| label: modify
creativity.d <- creativity.d %>%
rename(Treatment = Trtmnt) %>%
mutate(Treatment = recode(Treatment,
"Ext" = "Extrinsic",
"Int" = "Intrinsic"))
head(creativity.d)
#| label: import_data
# packages
library(dplyr)
library(ggplot2)
creativity.d <- read.csv("hw1_creativity.csv")
head(creativity.d)
View(creativity.d)
#| label: modify
creativity.d <- creativity.d %>%
rename(Treatment = Trtmnt) %>%
mutate(Treatment = recode(Treatment,
"Ext" = "Extrinsic",
"Int" = "Intrinsic"))
head(creativity.d)
#| label: dataframe Summary
creativity.sum <- creativity.d %>%
group_by(Treatment) %>%
summarise(
Mean = mean(Score),
Median = median(Score),
SD = sd(Score),
IQR = IQR(Score)
) %>%
mutate(across(where(is.numeric), ~ round(., 2)))
print(creativity.sum)
#| label: import_data
creativity.d <- read.csv("hw1_creativity.csv")
head(creativity.d)
#| label: modify
creativity.d <- creativity.d %>%
rename(Treatment = Trtmnt) %>%
mutate(Treatment = recode(Treatment,
"Ext" = "Extrinsic",
"Int" = "Intrinsic"))
head(creativity.d)
#| label: dataframe Summary
creativity.sum <- creativity.d %>%
group_by(Treatment) %>%
summarise(
Mean = mean(Score),
Median = median(Score),
SD = sd(Score),
IQR = IQR(Score)
) %>%
mutate(across(where(is.numeric), ~ round(., 2)))
print(creativity.sum)
#| label: Visualization
# loading ggplot
library(ggplot2)
#| label: a. Raw data visualization
ggplot(creativity.d, aes(x = Treatment, y = Score, fill = Treatment)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.2, alpha = 0.6, size = 1.5) +
labs(
title = "Creativity Scores by Motivational Orientation",
subtitle = "Boxplot with individual data points overlaid",
x = "Treatment Group",
y = "Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_minimal()
#| label: import_data
creativity.d <- read.csv("hw1_creativity.csv")
head(creativity.d)
#| label: modify
creativity.d <- creativity.d %>%
rename(Treatment = Trtmnt) %>%
mutate(Treatment = recode(Treatment,
"Ext" = "Extrinsic",
"Int" = "Intrinsic"))
head(creativity.d)
#| label: dataframe Summary
creativity.sum <- creativity.d %>%
group_by(Treatment) %>%
summarise(
Mean = mean(Score),
Median = median(Score),
SD = sd(Score),
IQR = IQR(Score)
) %>%
mutate(across(where(is.numeric), ~ round(., 2)))
print(creativity.sum)
#| label: Visualization
# loading ggplot
library(ggplot2)
#| label: a. Raw data visualization
# Distribution of creativity scores by treatment group (raw data)
ggplot(creativity.d, aes(x = Treatment, y = Score, fill = Treatment)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.2, alpha = 0.6, size = 1.5) +
labs(
title = "Creativity Scores by Motivational Orientation",
subtitle = "Boxplot with individual data points overlaid",
x = "Treatment Group",
y = "Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_minimal()
#| label: b. Summary data visualization
# Mean creativity scores with error bars by treatment
ggplot(creativity.sum, aes(x = Treatment, y = Mean, fill = Treatment)) +
geom_col(width = 0.6) +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD), width = 0.25) +
labs(
title = "Mean Creativity Score by Treatment Group",
subtitle = "Error bars represent ±1 standard deviation",
x = "Treatment Group",
y = "Mean Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_light()
print("A bar plot with error bars (SD) clearly communicates the central tendency and variability in a concise way. It’s effective for comparing just two groups and emphasizes the difference in means.")
#| label: b. Summary data visualization
# Mean creativity scores with error bars by treatment
ggplot(creativity.sum, aes(x = Treatment, y = Mean, fill = Treatment)) +
geom_col(width = 0.6) +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD), width = 0.25) +
labs(
title = "Mean Creativity Score by Treatment Group",
subtitle = "Error bars represent ±1 standard deviation",
x = "Treatment Group",
y = "Mean Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_light()
print("A bar plot with error bars (SD) clearly communicates the central tendency and variability in a concise way. It’s effective for comparing just two groups and emphasizes the difference in means.")
#| label: c. Modified axis version(duplicate)
# Mean creativity scores with custom axis scaling
ggplot(creativity.sum, aes(x = Treatment, y = Mean, fill = Treatment)) +
geom_col(width = 0.6) +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD), width = 0.25) +
scale_y_continuous(
breaks = seq(0, 30, 5),
limits = c(0, 30),
labels = seq(0, 30, 5)
) +
labs(
title = "Mean Creativity Score by Treatment Group",
subtitle = "Error bars represent ±1 standard deviation",
x = "Motivation Source",
y = "Mean Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_light()
#| label: b. Summary data visualization
# Mean creativity scores with error bars by treatment
ggplot(creativity.sum, aes(x = Treatment, y = Mean, fill = Treatment)) +
geom_col(width = 0.6) +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD), width = 0.25) +
labs(
title = "Mean Creativity Score by Treatment Group",
subtitle = "Error bars represent ±1 standard deviation",
x = "Treatment Group",
y = "Mean Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_light()
print("A bar plot with error bars (SD) clearly communicates the central tendency and variability in a concise way. It’s effective for comparing just two groups and emphasizes the difference in means.")
#| label: c. Modified axis version(duplicate)
# Mean creativity scores with custom axis scaling
ggplot(creativity.sum, aes(x = Treatment, y = Mean, fill = Treatment)) +
geom_col(width = 0.6) +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD), width = 0.25) +
scale_y_continuous(
breaks = seq(0, 30, 5),
limits = c(0, 30),
labels = seq(0, 30, 5)
) +
labs(
title = "Mean Creativity Score by Treatment Group",
subtitle = "Error bars represent ±1 standard deviation",
x = "Motivation Source",
y = "Mean Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_light()
#| label: import_data
library(dplyr)
creativity.d <- read.csv("hw1_creativity.csv")
head(creativity.d)
#| label: modify
creativity.d <- creativity.d %>%
rename(Treatment = Trtmnt) %>%
mutate(Treatment = recode(Treatment,
"Ext" = "Extrinsic",
"Int" = "Intrinsic"))
head(creativity.d)
#| label: dataframe Summary
creativity.sum <- creativity.d %>%
group_by(Treatment) %>%
summarise(
Mean = mean(Score),
Median = median(Score),
SD = sd(Score),
IQR = IQR(Score)
) %>%
mutate(across(where(is.numeric), ~ round(., 2)))
print(creativity.sum)
#| label: Visualization
# loading ggplot
library(ggplot2)
#| label: a. Raw data visualization
# Distribution of creativity scores by treatment group (raw data)
ggplot(creativity.d, aes(x = Treatment, y = Score, fill = Treatment)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.2, alpha = 0.6, size = 1.5) +
labs(
title = "Creativity Scores by Motivational Orientation",
subtitle = "Boxplot with individual data points overlaid",
x = "Treatment Group",
y = "Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_minimal()
print(" I chose a boxplot with jittered points because it shows the full distribution (median, quartiles, outliers) while also displaying every individual data point. This allows the viewer to see both summary statistics and the raw spread, which is good while comparing small group")
#| label: b. Summary data visualization
# Mean creativity scores with error bars by treatment
ggplot(creativity.sum, aes(x = Treatment, y = Mean, fill = Treatment)) +
geom_col(width = 0.6) +
geom_errorbar(aes(ymin = Mean - SD, ymax = Mean + SD), width = 0.25) +
labs(
title = "Mean Creativity Score by Treatment Group",
subtitle = "Error bars represent ±1 standard deviation",
