y = "Mean Creativity Score",
caption = "Data from Amabile, T. (1985)."
) +
theme_light()
print("A bar plot with error bars (SD) clearly communicates the central tendency and variability in a concise way. It’s effective for comparing just two groups and emphasizes the difference in means.")
