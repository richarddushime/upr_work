ln_params <- get_lognorm_params(5, 10)
dists <- list(
# Beta(3,12) distribution
Beta = list(
fun = dbeta,
params = list(shape1 = 3, shape2 = 12),
qfun = qbeta,
range = c(0, 1),
stats = c(
mean = 3/(3+12),
mode = (3-1)/(3+12-2)
)
),
# Gamma(5,10) distribution
Gamma = list(
fun = dgamma,
# Assuming appropriate shape/rate params.
